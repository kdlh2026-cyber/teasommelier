<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.teasommelier.dao.ICustomerServiceDao">
	<select id="CustomerServiceList" resultType="com.springboot.teasommelier.dto.CustomerServiceDto">
		select * from tea_customer_service order by cs_no desc
	</select>
	<select id="CustomerServiceView" resultType="com.springboot.teasommelier.dto.CustomerServiceDto">
		select * from tea_customer_service where cs_no=#{cs_no}
	</select>
	<insert id="CustomerServiceInsert">
		insert into tea_customer_service(cs_no,cs_category,cs_subject,cs_content)
		 values(tea_customer_service_seq.NEXTVAL,#{cs_category},#{cs_subject},#{cs_content})
	</insert>
	<update id="CustomerServiceUpdate">
		update tea_customer_service
		 set cs_subject=#{cs_subject},cs_content=#{cs_content}
		 where cs_no=#{cs_no}
	</update>
	<delete id="CustomerServiceDelete">
		delete from tea_customer_service where cs_no=#{cs_no}
	</delete>
</mapper>